#!/usr/bin/env bash
# compute-run: runs one compute job from its job directory and records the outcome.
#
#   compute-run <jobdir>             run the job in <jobdir>
#   compute-run --tasks <tasksfile>  Slurm array task: pick line SLURM_ARRAY_TASK_ID+1 as <jobdir>
#
# <jobdir> holds job.env (exports), command (the shell command), and optionally datasets
# (name<TAB>path lines), inputs (srcdir<TAB>glob<TAB>name lines), .secrets.env and cancel.
# The runner writes status.json, heartbeat and log there.
#
# With JOB_RUNTIME=docker or apptainer the command runs in JOB_IMAGE, with the snapshot at /work,
# outputs at /out, inputs at /in and each dataset read-only at /data/<name>.
#
# Works with bash 3.2 (macOS) and bash 5; needs no timeout, setsid or jq.
set -u

if [ "${1:-}" = "--tasks" ]; then
  jobdir=$(sed -n "$((SLURM_ARRAY_TASK_ID + 1))p" "$2")
else
  jobdir=${1:?usage: compute-run <jobdir>}
fi
cd "$jobdir" || exit 97

pid=0
started=$(date +%s)
ended=null
host=$(hostname)
tab=$(printf '\t')

note=""   # why a job failed, when the runner can tell (out of memory, out of disk)
write_status() { # <state> [exit_code]
  local tmp="$jobdir/status.json.tmp.$$"
  printf '{"state":"%s","pid":%s,"started":%s,"ended":%s,"exit_code":%s,"host":"%s","note":"%s"}\n' \
    "$1" "$pid" "$started" "$ended" "${2:-null}" "$host" "$(printf %s "$note" | tr -d '"\\\n')" > "$tmp" && mv -f "$tmp" "$jobdir/status.json"
}

# Free MB on the filesystem holding <dir>.
free_mb() { df -Pk "$1" 2>/dev/null | awk 'NR == 2 {print int($4 / 1024)}'; }

# OOM kills recorded for this runner's cgroup (Linux cgroup v2; Slurm and systemd put jobs in
# one). Native and Apptainer jobs run in it; Docker containers have their own.
oom_kills() {
  local cg
  cg=$(sed -n 's/^0:://p' /proc/self/cgroup 2>/dev/null)
  [ -n "$cg" ] && [ -r "/sys/fs/cgroup$cg/memory.events" ] || { echo 0; return; }
  awk '$1 == "oom_kill" {print $2}' "/sys/fs/cgroup$cg/memory.events"
}

# The runner's own exit status is non-zero unless the job succeeded, so Slurm's afterok
# dependencies hold back the jobs that need this one.
fail() { # <message> [exit_code]
  stop_setup_beat
  echo "compute: $1" >> "$jobdir/log"
  ended=$(date +%s)
  write_status failed "${2:-98}"
  exit 1
}

# shellcheck disable=SC1091
. "$jobdir/job.env"
secret_names=""
if [ -f "$jobdir/.secrets.env" ]; then
  secret_names=$(sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' "$jobdir/.secrets.env")
  set -a
  # shellcheck disable=SC1091
  . "$jobdir/.secrets.env"
  set +a
  rm -f "$jobdir/.secrets.env"
fi

# Setup (dataset links, input copies, an image pull) can take a while: report running and keep
# the heartbeat fresh from the start, so the daemon doesn't take a slow setup for a lost job.
setup_beat=0
stop_setup_beat() {
  [ "$setup_beat" -gt 0 ] && kill "$setup_beat" 2>/dev/null
  setup_beat=0
}
touch "$jobdir/heartbeat"
write_status running
runner_pid=$$
(while kill -0 "$runner_pid" 2>/dev/null; do touch "$jobdir/heartbeat"; sleep 30; done) &
setup_beat=$!
[ -d "$JOB_SNAPSHOT_DIR" ] || fail "snapshot dir $JOB_SNAPSHOT_DIR is missing"
mkdir -p "$JOB_OUTPUT_DIR" "$JOB_INPUT_DIR" "$JOB_DATA_DIR"

# Datasets: $JOB_DATA_DIR/<name> is a real directory tree of this host's copy, made of hard
# links (Linux) or copy-on-write clones (macOS), so it costs no space and `cp -a` or a Docker
# bind mount of it gets the data, not a link. A symlink is the last resort.
if [ -f "$jobdir/datasets" ]; then
  while IFS="$tab" read -r name path; do
    [ -n "$name" ] || continue
    [ -d "$path" ] || fail "dataset $name is missing at $path"
    dest="$JOB_DATA_DIR/$name"
    rm -rf "$dest"
    cp -al "$path" "$dest" 2>/dev/null || cp -cR "$path" "$dest" 2>/dev/null || {
      rm -rf "$dest"
      ln -sfn "$path" "$dest"
    }
  done < "$jobdir/datasets"
fi

# Inputs from jobs that ran on this host (or were fetched into its shared input cache): link
# them in rather than copying, so every task of an array shares one copy on disk: copy-on-write
# clones on macOS, hard links on Linux, a plain copy only if neither works. Containers see
# them read-only, so a job can't change its parent's outputs.
export COPYFILE_DISABLE=1
if [ -f "$jobdir/inputs" ]; then
  while IFS="$tab" read -r src glob name; do
    [ -n "$name" ] || continue
    [ -d "$src" ] || fail "outputs of the parent job are missing at $src"
    dest="$JOB_INPUT_DIR/$name"
    mkdir -p "$dest"
    (cd "$src" && find . -type f -path "./$glob") | while IFS= read -r f; do
      mkdir -p "$dest/$(dirname "$f")"
      cp -c "$src/$f" "$dest/$f" 2>/dev/null || ln -f "$src/$f" "$dest/$f" 2>/dev/null || cp -p "$src/$f" "$dest/$f" || exit 1
    done || fail "linking inputs from $src failed"
  done < "$jobdir/inputs"
fi

# Disk the job asked for (resources.disk_gb) must be free where its outputs go.
if [ "${JOB_DISK_MB:-0}" -gt 0 ]; then
  have=$(free_mb "$jobdir")
  if [ -n "$have" ] && [ "$have" -lt "$JOB_DISK_MB" ]; then
    note="not enough disk: $((have / 1024)) GB free on $host, the job asked for $((JOB_DISK_MB / 1024)) GB (resources.disk_gb)"
    fail "$note"
  fi
fi

cd "$JOB_SNAPSHOT_DIR" || fail "cannot enter $JOB_SNAPSHOT_DIR"
cmd=$(cat "$jobdir/command")
runtime=${JOB_RUNTIME:-native}
container_name="compute-$JOB_ID${NODE_RANK:+-$NODE_RANK}"

# Variables passed into a container: the job's env, its secrets and the runner's own.
pass_names() {
  sed -n 's/^export \([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' "$jobdir/job.env" \
    | grep -v -e '^JOB_RUNTIME$' -e '^JOB_IMAGE$' -e '^JOB_ROOT$'
  [ -z "$secret_names" ] || printf '%s\n' $secret_names
}
# The same paths as seen inside the container.
container_paths() {
  export JOB_SNAPSHOT_DIR=/work JOB_OUTPUT_DIR=/out JOB_INPUT_DIR=/in JOB_DATA_DIR=/data
}
in_shell='if command -v bash >/dev/null 2>&1; then exec bash -lc "$0"; else exec sh -c "$0"; fi'

start_docker() {
  command -v docker >/dev/null 2>&1 || fail "docker not found on $host"
  docker rm -f "$container_name" >/dev/null 2>&1
  local args
  # No --rm: the container is kept until its exit has been checked for an OOM kill.
  args=(run --init --name "$container_name" -w /work
        -v "$JOB_SNAPSHOT_DIR:/work" -v "$jobdir/out:/out" -v "$JOB_INPUT_DIR:/in:ro")
  if [ -f "$jobdir/datasets" ]; then
    while IFS="$tab" read -r name path; do
      [ -n "$name" ] && args+=(-v "$path:/data/$name:ro")
    done < "$jobdir/datasets"
  fi
  [ "${JOB_CPUS:-0}" -gt 0 ] && args+=(--cpus "$JOB_CPUS")
  [ "${JOB_MEM_MB:-0}" -gt 0 ] && args+=(--memory "${JOB_MEM_MB}m")
  if [ "${JOB_GPUS:-0}" -gt 0 ]; then
    args+=(--gpus all)
    # Name the device nodes too. With cgroup v2 and Docker's systemd cgroup driver, a systemd
    # reload on the host (snap refreshes, apt) drops the device access --gpus granted, and the
    # container loses its GPUs ("Failed to initialize NVML: Unknown Error"). Explicit
    # --device rules survive reloads.
    for d in /dev/nvidia* /dev/nvidia-caps/*; do
      [ -c "$d" ] && args+=(--device "$d")
    done
  fi
  [ -n "${NODE_RANK:-}" ] && args+=(--network host --ipc host)
  for n in $(pass_names); do args+=(-e "$n"); done
  args+=("$JOB_IMAGE" sh -c "$in_shell" "$cmd")
  set -m
  (container_paths; exec docker "${args[@]}") >> "$jobdir/log" 2>&1 < /dev/null &
  pid=$!
  set +m
}

start_apptainer() {
  if ! command -v apptainer >/dev/null 2>&1; then
    # Inside a batch job the module function may be missing; load Lmod's init first.
    if ! type module >/dev/null 2>&1; then
      for f in /etc/profile.d/lmod.sh /usr/share/lmod/lmod/init/bash; do
        # shellcheck disable=SC1090
        [ -f "$f" ] && . "$f" && break
      done
    fi
    type module >/dev/null 2>&1 && module load apptainer >/dev/null 2>&1
  fi
  command -v apptainer >/dev/null 2>&1 || fail "apptainer not found on $host"
  export APPTAINER_CACHEDIR="$JOB_ROOT/cache/apptainer"
  mkdir -p "$JOB_ROOT/cache/sif" "$APPTAINER_CACHEDIR"
  local key sif
  key=$(printf %s "$JOB_IMAGE" | { sha256sum 2>/dev/null || shasum -a 256; } | cut -c1-32)
  sif="$JOB_ROOT/cache/sif/$key.sif"
  if [ ! -f "$sif" ]; then
    echo "compute: converting $JOB_IMAGE to $sif" >> "$jobdir/log"
    (
      flock 9
      [ -f "$sif" ] || { apptainer pull --force "$sif.tmp.$$" "docker://$JOB_IMAGE" && mv -f "$sif.tmp.$$" "$sif"; }
    ) 9> "$sif.lock" >> "$jobdir/log" 2>&1
    [ -f "$sif" ] || fail "pulling $JOB_IMAGE failed"
  fi
  local binds="$JOB_SNAPSHOT_DIR:/work,$jobdir/out:/out,$JOB_INPUT_DIR:/in:ro"
  if [ -f "$jobdir/datasets" ]; then
    while IFS="$tab" read -r name path; do
      [ -n "$name" ] && binds="$binds,$path:/data/$name:ro"
    done < "$jobdir/datasets"
  fi
  local nv=""
  [ "${JOB_GPUS:-0}" -gt 0 ] && nv="--nv"
  set -m
  (
    container_paths
    for n in $(pass_names); do export "APPTAINERENV_$n=${!n}"; done
    exec apptainer exec --cleanenv $nv --bind "$binds" --pwd /work "$sif" sh -c "$in_shell" "$cmd"
  ) >> "$jobdir/log" 2>&1 < /dev/null &
  pid=$!
  set +m
}

prelude='export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"'
case "$runtime" in
  docker) start_docker ;;
  apptainer) start_apptainer ;;
  *)
    set -m   # the job gets its own process group, so cancel/timeout can kill all of it
    bash -lc "$prelude
$cmd" >> "$jobdir/log" 2>&1 < /dev/null &
    pid=$!
    set +m
    ;;
esac
oom_before=$(oom_kills)
stop_setup_beat
write_status running

# Resource usage every 10 s: metrics.json (latest) and metrics.jsonl (history).
sample_metrics() {
  local now cpu rss gpus disk stats ids
  now=$(date +%s)
  if [ "$runtime" = docker ]; then
    stats=$(docker stats --no-stream --format '{{.CPUPerc}}|{{.MemUsage}}' "$container_name" 2>/dev/null)
    cpu=$(printf '%s' "$stats" | awk -F'|' '{gsub(/%/, "", $1); print ($1 == "" ? 0 : $1)}')
    rss=$(printf '%s' "$stats" | awk -F'|' '{split($2, m, " / "); v = m[1]; n = v + 0;
      if (v ~ /GiB|GB/) n *= 1024; else if (v ~ /KiB|kB/) n /= 1024; else if (v ~ /[0-9]B$/) n /= 1048576;
      printf "%d", n}')
  else
    # The job is its own process group (pgid = $pid): sum over it.
    # shellcheck disable=SC2046  # two numbers, split on purpose
    set -- $(ps -A -o pgid= -o pcpu= -o rss= 2>/dev/null | awk -v g="$pid" '$1 == g {c += $2; r += $3} END {printf "%.1f %d", c, r / 1024}')
    cpu=${1:-0}
    rss=${2:-0}
  fi
  gpus=""
  if [ "${JOB_GPUS:-0}" -gt 0 ] && command -v nvidia-smi >/dev/null 2>&1; then
    ids=""
    [ -n "${CUDA_VISIBLE_DEVICES:-}" ] && ids="-i $CUDA_VISIBLE_DEVICES"
    # shellcheck disable=SC2086
    gpus=$(nvidia-smi $ids --query-gpu=index,utilization.gpu,memory.used,memory.total,power.draw \
        --format=csv,noheader,nounits 2>/dev/null \
      | awk -F', *' 'function num(x) { return (x ~ /^[0-9.]+$/) ? x : "null" }
          { printf "%s{\"index\":%s,\"util_pct\":%s,\"mem_used_mb\":%s,\"mem_total_mb\":%s,\"power_w\":%s}",
            (NR > 1 ? "," : ""), num($1), num($2), num($3), num($4), num($5) }')
  fi
  disk=$(df -k "$jobdir" 2>/dev/null | awk 'NR == 2 {printf "%.1f", $4 / 1048576}')
  printf '{"t":%s,"cpu_pct":%s,"rss_mb":%s,"gpus":[%s],"disk_free_gb":%s,"host":"%s"}\n' \
    "$now" "${cpu:-0}" "${rss:-0}" "$gpus" "${disk:-null}" "$host" > "$jobdir/metrics.json.tmp" &&
    mv -f "$jobdir/metrics.json.tmp" "$jobdir/metrics.json" &&
    cat "$jobdir/metrics.json" >> "$jobdir/metrics.jsonl"
}

kill_job() {
  [ "$runtime" = docker ] && docker rm -f "$container_name" >/dev/null 2>&1
  kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null
  for _ in 1 2 3 4 5; do
    kill -0 "$pid" 2>/dev/null || return 0
    sleep 2
  done
  kill -KILL -- "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null
}

final=""
last_beat=$started
last_sample=0
while kill -0 "$pid" 2>/dev/null; do
  now=$(date +%s)
  if [ $((now - last_sample)) -ge 10 ]; then
    sample_metrics
    last_sample=$now
  fi
  if [ -f "$jobdir/cancel" ]; then
    final=cancelled
    echo "compute: cancelled" >> "$jobdir/log"
    kill_job
    break
  fi
  if [ "${JOB_TIMEOUT_S:-0}" -gt 0 ] && [ $((now - started)) -ge "$JOB_TIMEOUT_S" ]; then
    final=timeout
    echo "compute: time limit of ${JOB_TIMEOUT_S}s reached" >> "$jobdir/log"
    kill_job
    break
  fi
  if [ $((now - last_beat)) -ge 30 ]; then
    touch "$jobdir/heartbeat"
    last_beat=$now
  fi
  sleep 2
done

wait "$pid"
code=$?
ended=$(date +%s)
if [ -z "$final" ]; then
  if [ "$code" -eq 0 ]; then final=succeeded; else final=failed; fi
fi

# Why it failed, when it's one of the usual two: out of memory or out of disk.
oomed=""
if [ "$runtime" = docker ]; then
  [ "$(docker inspect -f '{{.State.OOMKilled}}' "$container_name" 2>/dev/null)" = true ] && oomed=1
  docker rm -f "$container_name" >/dev/null 2>&1
fi
[ "$(oom_kills)" -gt "${oom_before:-0}" ] 2>/dev/null && oomed=1
if [ "$final" = failed ]; then
  if [ -n "$oomed" ]; then
    note="out of memory: the job was killed for using more than resources.mem_gb (${JOB_MEM_MB:-?} MB); raise it"
  elif tail -c 200000 "$jobdir/log" 2>/dev/null | grep -qiE 'no space left on device|disk quota exceeded'; then
    fm=$(free_mb "$jobdir")
    note="out of disk: no space left on device ($(( ${fm:-0} / 1024 )) GB free now); raise resources.disk_gb or write less"
  elif [ "$code" -eq 137 ]; then
    note="killed (exit 137, SIGKILL), most often for running out of memory; check memory use with compute metrics and raise resources.mem_gb"
  fi
  [ -n "$note" ] && echo "compute: $note" >> "$jobdir/log"
fi
write_status "$final" "$code"
[ "$final" = succeeded ] && exit 0
# Outside Slurm a cancel isn't a failure (Rex shows the pane's exit status).
[ "$final" = cancelled ] && [ -z "${SLURM_JOB_ID:-}" ] && exit 0
exit 1
